<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.fr.plugin</groupId>
    <artifactId>report-debug-assistant</artifactId>
    <version>1.0.9</version>
    <packaging>jar</packaging>
    <name>report-debug-assistant</name>
    <description>FineReport dataset debug assistant plugin</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <fr.lib.dir>${project.basedir}/finereport11</fr.lib.dir>
        <fr.plugin.id>com.fr.plugin.report.debug.assistant</fr.plugin.id>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fr</groupId>
            <artifactId>fine-core</artifactId>
            <version>11.0</version>
            <scope>system</scope>
            <systemPath>${fr.lib.dir}/fine-core-11.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.fr</groupId>
            <artifactId>fine-report-engine</artifactId>
            <version>11.0</version>
            <scope>system</scope>
            <systemPath>${fr.lib.dir}/fine-report-engine-11.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.fr</groupId>
            <artifactId>fine-decision</artifactId>
            <version>11.0</version>
            <scope>system</scope>
            <systemPath>${fr.lib.dir}/fine-decision-11.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.fr</groupId>
            <artifactId>fine-decision-report</artifactId>
            <version>11.0</version>
            <scope>system</scope>
            <systemPath>${fr.lib.dir}/fine-decision-report-11.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.fr</groupId>
            <artifactId>fine-cbb</artifactId>
            <version>11.0</version>
            <scope>system</scope>
            <systemPath>${fr.lib.dir}/fine-cbb-11.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.fr</groupId>
            <artifactId>fine-datasource</artifactId>
            <version>11.0</version>
            <scope>system</scope>
            <systemPath>${fr.lib.dir}/fine-datasource-11.0.jar</systemPath>
        </dependency>
        <!-- 编译期：Spring 等（运行时由 FR 提供，不打入插件包） -->
        <dependency>
            <groupId>com.fr</groupId>
            <artifactId>fine-third</artifactId>
            <version>11.0</version>
            <scope>system</scope>
            <systemPath>${fr.lib.dir}/fine-third-11.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>report-debug-assistant-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Build-Jdk-Spec>1.8</Build-Jdk-Spec>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>plugin-release-zip</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <appendAssemblyId>false</appendAssemblyId>
                            <finalName>plugin-${fr.plugin.id}-${project.version}</finalName>
                            <descriptors>
                                <descriptor>src/assembly/plugin-release.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
